<?xml version="1.0" encoding="utf-8"?>
<!-- Template: packaging/msix.ps1 fills in @NAME@, @PUBLISHER@, @PUBLISHER_DISPLAY@ and @VERSION@.
     Identity Name and Publisher must match the reservation in Partner Center exactly, or the Store
     rejects the upload; Publisher is the "Package/Identity/Publisher" string there, not a name. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="@NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>deskMonk</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 is the oldest Windows 10 that still gets security updates and runs the wgpu DX12 path. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en" />
    <Resource Language="tr" />
    <Resource Language="es" />
  </Resources>

  <Applications>
    <!-- FullTrustApplication: a plain desktop .exe, not a sandboxed UWP app. A cleaner has to walk
         the user's folders and delete from them, which the container does not allow. -->
    <Application Id="deskMonk" Executable="deskmonk.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="deskMonk"
        Description="Finds junk, duplicates, old downloads and large files, and shows what deleting them frees."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- No 310x310 tile: Windows then also demands a wide 310x150 one, and a square app icon
             letterboxed onto a wide canvas looks worse than the medium tile Windows falls back to. -->
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Both are restricted: Partner Center asks for a written justification and a human reads it.
         runFullTrust is routine for a desktop app. broadFileSystemAccess is not, and it is what the
         scan needs to see anything outside the app's own folders. -->
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
